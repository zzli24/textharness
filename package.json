{
  "name": "textharness",
  "version": "0.8.5",
  "description": "TextHarness - 轻量本地文本编辑器 + 内置 AI 助手",
  "main": "./out/main/index.js",
  "license": "MIT",
  "author": "TextHarness",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "selftest": "node scripts/selftest.mjs",
    "test:agent": "node scripts/test-agent.mjs",
    "test:services": "node scripts/test-services.mjs",
    "test:session-images": "node scripts/test-session-images.mjs",
    "test:markdown": "node scripts/test-markdown.mjs",
    "test:grid": "node scripts/test-grid.mjs",
    "test:modelparams": "node scripts/test-modelparams.mjs",
    "test:chaturl": "node scripts/test-chaturl.mjs",
    "test:updatechip": "node scripts/test-updatechip.mjs",
    "test:import": "node scripts/test-import.mjs",
    "start": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --win dir",
    "dist": "electron-vite build && electron-builder --win nsis",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "smoke": "electron-vite build && electron .",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "adm-zip": "^0.6.1",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.11",
    "html-to-image": "^1.11.13",
    "iconv-lite": "^0.6.3",
    "katex": "^0.19.1",
    "mammoth": "^1.13.0",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "turndown": "^7.2.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/language": "^6.10.3",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.34.3",
    "@electron/notarize": "^3.1.2",
    "@types/adm-zip": "^0.5.8",
    "@types/turndown": "^5.0.6",
    "@xenova/transformers": "^2.17.2",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
